# Names only. Values live in the host's secret store, or in a local .env that is never committed.

# Postgres. The app connects as a role that cannot bypass row-level security.
DATABASE_URL=
# Owner role used only to run migrations and the seed.
DATABASE_OWNER_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Where generated PDFs and logos are kept in development.
FILE_STORAGE_DIR=

# Optional: path to a Chromium binary for PDF rendering.
CHROMIUM_PATH=
# Secret for the scheduler's call to /api/jobs/drain. Use letters and digits only.
CRON_SECRET=

# Email. EMAIL_PROVIDER=file writes each email to MAILBOX_DIR as an .eml file (development); resend sends through
# Resend (decision 0008) with RESEND_API_KEY. EMAIL_FROM is an address on the verified sending subdomain.
EMAIL_PROVIDER=
EMAIL_FROM=
MAILBOX_DIR=
RESEND_API_KEY=

# Plans: set to enforced to apply the trial and the free plan's limits (docs/specs/plans.md). Unset, everyone has everything.
INVOICA_PLANS=

# Where sign-in's limits read the client's address from (required in production, one of the two): a header the
# proxy in front of the app overwrites on every request, or the proxies' addresses (comma separated, CIDR allowed).
# Behind Cloudflare: INVOICA_CLIENT_IP_HEADER=cf-connecting-ip
INVOICA_CLIENT_IP_HEADER=
INVOICA_TRUSTED_PROXIES=
