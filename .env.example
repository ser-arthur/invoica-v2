# Names only. Values live in the host's secret store, or in a local .env that is never committed.

# Postgres. The app connects as a role that cannot bypass row-level security.
DATABASE_URL=
# Owner role used only to run migrations and the seed.
DATABASE_OWNER_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Where generated PDFs and logos are kept in development.
FILE_STORAGE_DIR=

# Optional: path to a Chromium binary for PDF rendering.
CHROMIUM_PATH=
# Secret for the scheduler's call to /api/jobs/drain. Use letters and digits only.
CRON_SECRET=

# Email. EMAIL_PROVIDER=file writes each email to MAILBOX_DIR as an .eml file (development).
EMAIL_PROVIDER=
EMAIL_FROM=
MAILBOX_DIR=

# Plans: set to enforced to apply the trial and the free plan's limits (docs/specs/plans.md). Unset, everyone has everything.
INVOICA_PLANS=
