    "@invoica/schemas": "workspace:*",
    "@sparticuz/chromium": "141.0.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.10",
    "lucide-react": "1.50.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
