{
  "name": "invoica",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @invoica/web dev",
    "build": "pnpm --filter @invoica/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @invoica/core test",
    "test:db": "pnpm --filter @invoica/db test",
    "test:e2e": "pnpm --filter @invoica/web test:e2e",
    "db:migrate": "pnpm --filter @invoica/db migrate",
    "db:seed": "pnpm --filter @invoica/db seed",
    "copy:check": "node scripts/copy-check.mjs",
    "check": "pnpm format:check && pnpm copy:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
