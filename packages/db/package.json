  },
  "dependencies": {
    "@invoica/core": "workspace:*",
    "@invoica/schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
